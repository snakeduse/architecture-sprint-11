@startuml
!include <C4/C4_Context>

title Data Flow Diagram (DFD) между доменами

' ---------- Домены ----------
System_Boundary(Медицинский_домен, "Медицинский домен") {
    System(ИИ_сервисы, "ИИ-сервисы", "Обработка медицинских данных")
    SystemDb(Мед_данные, "Медицинские данные", "Снимки, результаты анализов (Delta Lake)")
}

System_Boundary(Финансовый_домен, "Финансовый домен") {
    System(Финтех, "Финтех-сервисы", "Транзакции, кредиты")
    SystemDb(Фин_агрегаты, "Финансовые агрегаты", "Pre-aggregated views (Delta Lake)")
}

System_Boundary(Аналитический_домен, "Аналитический домен") {
    System(BI, "BI-система", "Power BI / Tableau")
    System(Портал, "Портал самообслуживания", "Создание отчетов")
}

System_Boundary(Операционный_домен, "Операционный домен") {
    System(Управление, "Внутренние сервисы", "Клиники, персонал, инвентарь")
}

System_Boundary(Интеграционный_домен, "Интеграционный домен") {
    System(Шина, "Kafka", "Стриминг событий")
    System(Обработка, "Spark Streaming", "Потоковая обработка")
}

System_Boundary(Административный_домен, "Административный домен") {
    System(Админ, "Apache Ranger", "RBAC-политики")
}

' ---------- Потоки данных ----------

' Медицинский домен
ИИ_сервисы --> Шина : "События диагностики (Avro)"
Шина --> Обработка : "Медицинские данные"
Обработка --> Мед_данные : "Сохранение в Lakehouse"
Мед_данные --> BI : "Доступ к данным (Spark SQL)"

' Финансовый домен
Финтех --> Шина : "Транзакции (JSON)"
Шина --> Обработка : "Финансовые данные"
Обработка --> Фин_агрегаты : "Агрегация"
Фин_агрегаты --> BI : "Финансовые метрики (JDBC)"

' Аналитический домен
Портал --> BI : "Запрос отчетов (REST)"
BI --> Портал : "Визуализации (HTML/JS)"

' Операционный домен
Управление --> Шина : "Операционные события (XML)"
Шина --> Обработка : "Данные клиник"
Обработка --> Мед_данные : "Интеграция"

' Административный домен
Админ --> Мед_данные : "Управление доступом"
Админ --> Фин_агрегаты : "Управление доступом"
Админ --> Управление : "Политики безопасности"

@enduml